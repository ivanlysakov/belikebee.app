{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(gh pr create *)",
      "Bash(* --version)",
      "Bash(* --help)"
    ],
    "ask": ["Bash(gh pr merge *)"],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.kube/config"],
      "allowWrite": ["/tmp/build", "~/.kube/cache"]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "api.anthropic.com",
        "statsig.anthropic.com"
      ],
      "allowManagedDomainsOnly": false
    },
    "excludedCommands": ["docker"],
    "allowUnsandboxedCommands": true
  },
  "worktree": {
    "symlinkDirectories": ["node_modules", ".cache"]
  }
}
